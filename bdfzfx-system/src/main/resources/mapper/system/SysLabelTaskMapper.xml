<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdfzfx.system.mapper.SysLabelTaskMapper">
    
    <resultMap type="SysLabelTask" id="SysLabelTaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="taskName"    column="task_name"    />
        <result property="sampleCount"    column="sample_count"    />
        <result property="completedCount"    column="completed_count"    />
        <result property="handler"    column="handler"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysLabelTaskVo">
        select task_id, task_name, sample_count, completed_count, handler, status, create_by, create_time, update_by, update_time, remark from sys_label_task
    </sql>

    <select id="selectSysLabelTaskList" parameterType="SysLabelTask" resultMap="SysLabelTaskResult">
        <include refid="selectSysLabelTaskVo"/>
        <where>  
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="taskName != null  and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="sampleCount != null "> and sample_count = #{sampleCount}</if>
            <if test="completedCount != null "> and completed_count = #{completedCount}</if>
            <if test="handler != null  and handler != ''"> and handler = #{handler}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectSysLabelTaskByTaskId" parameterType="Long" resultMap="SysLabelTaskResult">
        <include refid="selectSysLabelTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertSysLabelTask" parameterType="SysLabelTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into sys_label_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="sampleCount != null">sample_count,</if>
            <if test="completedCount != null">completed_count,</if>
            <if test="handler != null">handler,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="sampleCount != null">#{sampleCount},</if>
            <if test="completedCount != null">#{completedCount},</if>
            <if test="handler != null">#{handler},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysLabelTask" parameterType="SysLabelTask">
        update sys_label_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="sampleCount != null">sample_count = #{sampleCount},</if>
            <if test="completedCount != null">completed_count = #{completedCount},</if>
            <if test="handler != null">handler = #{handler},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteSysLabelTaskByTaskId" parameterType="Long">
        delete from sys_label_task where task_id = #{taskId}
    </delete>

    <delete id="deleteSysLabelTaskByTaskIds" parameterType="String">
        delete from sys_label_task where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>