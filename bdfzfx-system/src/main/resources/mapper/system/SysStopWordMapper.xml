<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdfzfx.system.mapper.SysStopWordMapper">
    
    <resultMap type="SysStopWord" id="SysStopWordResult">
        <result property="id"    column="id"    />
        <result property="stopWord"    column="stop_word"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysStopWordVo">
        select id, stop_word, create_by, create_time, update_by, update_time, remark from sys_stop_word
    </sql>

    <select id="selectSysStopWordList" parameterType="SysStopWord" resultMap="SysStopWordResult">
        <include refid="selectSysStopWordVo"/>
        <where>  
            <if test="stopWord != null  and stopWord != ''"> and stop_word = #{stopWord}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
        </where>
    </select>
    
    <select id="selectSysStopWordById" parameterType="Long" resultMap="SysStopWordResult">
        <include refid="selectSysStopWordVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysStopWord" parameterType="SysStopWord" useGeneratedKeys="true" keyProperty="id">
        insert into sys_stop_word
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stopWord != null and stopWord != ''">stop_word,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stopWord != null and stopWord != ''">#{stopWord},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysStopWord" parameterType="SysStopWord">
        update sys_stop_word
        <trim prefix="SET" suffixOverrides=",">
            <if test="stopWord != null and stopWord != ''">stop_word = #{stopWord},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysStopWordById" parameterType="Long">
        delete from sys_stop_word where id = #{id}
    </delete>

    <delete id="deleteSysStopWordByIds" parameterType="String">
        delete from sys_stop_word where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>