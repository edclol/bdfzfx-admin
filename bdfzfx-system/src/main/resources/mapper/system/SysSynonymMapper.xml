<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdfzfx.system.mapper.SysSynonymMapper">
    
    <resultMap type="SysSynonym" id="SysSynonymResult">
        <result property="id"    column="id"    />
        <result property="word"    column="word"    />
        <result property="synonym"    column="synonym"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysSynonymVo">
        select id, word, synonym, create_by, create_time, update_by, update_time, remark from sys_synonym
    </sql>

    <select id="selectSysSynonymList" parameterType="SysSynonym" resultMap="SysSynonymResult">
        <include refid="selectSysSynonymVo"/>
        <where>  
            <if test="word != null  and word != ''"> and word = #{word}</if>
            <if test="synonym != null  and synonym != ''"> and synonym = #{synonym}</if>
            <if test="createBy != null  and createBy != ''"> and create_by = #{createBy}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
        </where>
    </select>
    
    <select id="selectSysSynonymById" parameterType="Long" resultMap="SysSynonymResult">
        <include refid="selectSysSynonymVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysSynonym" parameterType="SysSynonym" useGeneratedKeys="true" keyProperty="id">
        insert into sys_synonym
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="word != null and word != ''">word,</if>
            <if test="synonym != null and synonym != ''">synonym,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="word != null and word != ''">#{word},</if>
            <if test="synonym != null and synonym != ''">#{synonym},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysSynonym" parameterType="SysSynonym">
        update sys_synonym
        <trim prefix="SET" suffixOverrides=",">
            <if test="word != null and word != ''">word = #{word},</if>
            <if test="synonym != null and synonym != ''">synonym = #{synonym},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysSynonymById" parameterType="Long">
        delete from sys_synonym where id = #{id}
    </delete>

    <delete id="deleteSysSynonymByIds" parameterType="String">
        delete from sys_synonym where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>